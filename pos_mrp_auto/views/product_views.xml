<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_pos_mrp" model="ir.ui.view">
        <field name="name">product.template.form.pos.mrp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Inventory tab -->
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="POS Manufacturing">
                    <field name="manufacture_from_pos"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
